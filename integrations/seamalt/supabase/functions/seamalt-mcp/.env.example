# シーモルト連携MCP（Supabase Edge Function seamalt-mcp）の設定例。秘密値はここに書かない。
# 秘密値（SEAMALT_DB_URL）は本人が Supabase ダッシュボード > Edge Functions > Secrets で登録する。
SEAMALT_DB_URL=            # 秘密: postgres://seamalt_mcp.<project-ref>:<パスワード>@<pooler-host>:6543/postgres
SEAMALT_RESOURCE=https://clpdyrehdgzgiidbfucj.supabase.co/functions/v1/seamalt-mcp/mcp
SEAMALT_ISSUER=https://clpdyrehdgzgiidbfucj.supabase.co/auth/v1
SEAMALT_JWKS_URL=https://clpdyrehdgzgiidbfucj.supabase.co/auth/v1/.well-known/jwks.json
# Supabase Auth の OAuth トークンは aud=authenticated 固定（resource を aud に入れない）。
# そのため authenticated を受け入れ、代わりに client_id（シーモルト用に登録されたクライアント）で絞る。docs/04-connect.md 参照
SEAMALT_AUDIENCES=https://clpdyrehdgzgiidbfucj.supabase.co/functions/v1/seamalt-mcp/mcp,authenticated
SEAMALT_CLIENT_IDS=        # 接続時に決まるシーモルトの OAuth client_id（秘密ではない）
SEAMALT_MAX_TOKEN_LIFETIME=3600
SEAMALT_SCOPE_SOURCE=principal
SEAMALT_DETAIL_URL=        # 受発注画面の ?order= 対応版をデプロイした後に https://tateyama-gibier.vercel.app/order-admin.html
